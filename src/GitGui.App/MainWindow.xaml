<Window x:Class="GitGui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitGui.App"
        xmlns:vm="clr-namespace:GitGui.App.ViewModels"
        xmlns:views="clr-namespace:GitGui.App.Views"
        xmlns:conv="clr-namespace:GitGui.App.Converters"
        mc:Ignorable="d"
        Title="Git GUI" Height="720" Width="1200">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="開く..." Command="{Binding OpenRepositoryDialogCommand}" Margin="0,0,4,0"/>
            <Button Content="クローン..." Command="{Binding CloneRepositoryDialogCommand}" Margin="0,0,4,0"/>
            <Separator/>
            <Button Content="Fetch" Command="{Binding FetchCommand}" IsEnabled="{Binding IsRepositoryOpen}" Margin="0,0,4,0"/>
            <Button Content="Pull" Command="{Binding PullCommand}" IsEnabled="{Binding IsRepositoryOpen}" Margin="0,0,4,0"/>
            <Button Content="Push" Command="{Binding PushCommand}" IsEnabled="{Binding IsRepositoryOpen}" Margin="0,0,4,0"/>
            <Separator/>
            <Button Content="更新" Command="{Binding RefreshAllCommand}" IsEnabled="{Binding IsRepositoryOpen}" Margin="0,0,4,0"/>
            <Separator/>
            <Border Background="{StaticResource SelectedBackgroundBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" FontSize="9" Foreground="{StaticResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding CurrentBranchName}" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding RepositoryPath}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="120" Height="14"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" IsEnabled="{Binding IsRepositoryOpen}">
            <TabItem Header="変更">
                <views:ChangesView DataContext="{Binding ChangesVm}"/>
            </TabItem>
            <TabItem Header="履歴">
                <views:HistoryView DataContext="{Binding HistoryVm}"/>
            </TabItem>
            <TabItem Header="ブランチ">
                <views:BranchesView DataContext="{Binding BranchesVm}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
