<Window x:Class="GitGui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitGui.App"
        xmlns:vm="clr-namespace:GitGui.App.ViewModels"
        xmlns:views="clr-namespace:GitGui.App.Views"
        xmlns:conv="clr-namespace:GitGui.App.Converters"
        mc:Ignorable="d"
        Icon="Assets/app.ico"
        Title="Git GUI" Height="720" Width="1200">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource SelectedBackgroundBrush}"
                        CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" FontSize="9" Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentBranchName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="開く..." Style="{StaticResource ToolbarButton}" Command="{Binding OpenRepositoryDialogCommand}"/>
                    <Button Content="クローン..." Style="{StaticResource ToolbarButton}" Command="{Binding CloneRepositoryDialogCommand}"/>
                    <Separator/>
                    <Button Content="Fetch" Style="{StaticResource ToolbarButton}" Command="{Binding FetchCommand}" IsEnabled="{Binding IsRepositoryOpen}"/>
                    <Button Content="Pull" Style="{StaticResource ToolbarButton}" Command="{Binding PullCommand}" IsEnabled="{Binding IsRepositoryOpen}"/>
                    <Button Content="Push" Style="{StaticResource ToolbarButton}" Command="{Binding PushCommand}" IsEnabled="{Binding IsRepositoryOpen}"/>
                    <Separator/>
                    <Button Content="更新" Style="{StaticResource ToolbarButton}" Command="{Binding RefreshAllCommand}" IsEnabled="{Binding IsRepositoryOpen}"/>
                    <Separator/>
                    <ComboBox Width="200" VerticalAlignment="Center" Margin="0,0,6,0"
                              ItemsSource="{Binding Identities}" SelectedItem="{Binding SelectedIdentity}"
                              DisplayMemberPath="DisplayName" IsEnabled="{Binding IsRepositoryOpen}"
                              ToolTip="このリポジトリで使うアカウント（名前・メール）を切り替えます。"/>
                    <Button Content="アカウント管理..." Style="{StaticResource ToolbarButton}" Command="{Binding ManageIdentitiesCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding RepositoryPath}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="120" Height="14"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" IsEnabled="{Binding IsRepositoryOpen}">
            <TabItem Header="変更">
                <views:ChangesView DataContext="{Binding ChangesVm}"/>
            </TabItem>
            <TabItem Header="履歴">
                <views:HistoryView DataContext="{Binding HistoryVm}"/>
            </TabItem>
            <TabItem Header="ブランチ">
                <views:BranchesView DataContext="{Binding BranchesVm}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
