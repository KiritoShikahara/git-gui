<Window x:Class="GitGui.App.Views.IdentitiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.ico"
        Background="{StaticResource AppBackgroundBrush}"
        Title="アカウントの管理" Height="380" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" x:Name="IdentityListBox" DisplayMemberPath="DisplayName"
                  SelectionChanged="IdentityListBox_SelectionChanged"/>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="名前" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="NameTextBox" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="メールアドレス" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="EmailTextBox" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="追加" Style="{StaticResource SecondaryButton}" Width="80" Click="AddButton_Click"/>
            <Button Content="更新" Style="{StaticResource SecondaryButton}" Width="80" Margin="6,0,0,0" Click="UpdateButton_Click"/>
            <Button Content="削除" Style="{StaticResource SecondaryButton}" Width="80" Margin="6,0,0,0" Click="RemoveButton_Click"/>
            <Button Content="閉じる" Style="{StaticResource PrimaryButton}" Width="80" Margin="18,0,0,0" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
