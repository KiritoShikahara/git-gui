<UserControl x:Class="GitGui.App.Views.ChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:GitGui.App.Converters"
             xmlns:views="clr-namespace:GitGui.App.Views"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:FileChangeKindToLabelConverter x:Key="KindLabelConverter"/>
        <conv:FileChangeKindToBrushConverter x:Key="KindBrushConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <DataTemplate x:Key="UnstagedFileTemplate">
            <DockPanel Margin="2">
                <Button DockPanel.Dock="Right" Content="破棄" Style="{StaticResource InlineActionButton}"
                        Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource InlineActionButton}" FontWeight="Bold"
                        Command="{Binding DataContext.StageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
                <TextBlock Width="16" FontWeight="Bold" TextAlignment="Center"
                           Text="{Binding Kind, Converter={StaticResource KindLabelConverter}}"
                           Foreground="{Binding Kind, Converter={StaticResource KindBrushConverter}}"/>
                <TextBlock Text="{Binding Path}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="StagedFileTemplate">
            <DockPanel Margin="2">
                <Button DockPanel.Dock="Right" Content="-" Style="{StaticResource InlineActionButton}" FontWeight="Bold"
                        Command="{Binding DataContext.UnstageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
                <TextBlock Width="16" FontWeight="Bold" TextAlignment="Center"
                           Text="{Binding Kind, Converter={StaticResource KindLabelConverter}}"
                           Foreground="{Binding Kind, Converter={StaticResource KindBrushConverter}}"/>
                <TextBlock Text="{Binding Path}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Commit box -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                <DockPanel Margin="0,8,0,0">
                    <CheckBox Content="Amend" IsChecked="{Binding Amend}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <Button Content="コミット" Style="{StaticResource PrimaryButton}" Command="{Binding CommitCommand}" Width="130" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- File lists + diff -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Margin="0,0,6,5">
                    <GroupBox.Header>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="全てアンステージ" Style="{StaticResource InlineActionButton}" Command="{Binding UnstageAllCommand}"/>
                            <TextBlock Text="ステージ済み" VerticalAlignment="Center"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <ListBox ItemsSource="{Binding StagedFiles}" SelectedItem="{Binding SelectedFile}"
                             BorderThickness="0"
                             ItemTemplate="{StaticResource StagedFileTemplate}"/>
                </GroupBox>

                <GroupBox Grid.Row="1" Margin="0,5,6,0">
                    <GroupBox.Header>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="全てステージ" Style="{StaticResource InlineActionButton}" Command="{Binding StageAllCommand}"/>
                            <TextBlock Text="未ステージ" VerticalAlignment="Center"/>
                        </DockPanel>
                    </GroupBox.Header>
                    <ListBox ItemsSource="{Binding UnstagedFiles}" SelectedItem="{Binding SelectedFile}"
                             BorderThickness="0"
                             ItemTemplate="{StaticResource UnstagedFileTemplate}"/>
                </GroupBox>
            </Grid>

            <Border Grid.Column="1" Margin="6,0,0,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                <views:DiffView DataContext="{Binding CurrentDiff}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
