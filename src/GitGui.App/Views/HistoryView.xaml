<UserControl x:Class="GitGui.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:GitGui.App.Controls"
             xmlns:views="clr-namespace:GitGui.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
            <ListBox ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit}"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <controls:CommitGraphCell Grid.Column="0" Commit="{Binding}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="{Binding ShortSha}" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding MessageShort}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding AuthorName}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding When, StringFormat='yyyy-MM-dd HH:mm'}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="変更されたファイル" Margin="0,0,6,0">
                <ListBox ItemsSource="{Binding SelectedCommitFiles}" SelectedItem="{Binding SelectedFileDiff}"
                         BorderThickness="0"
                         DisplayMemberPath="Path"/>
            </GroupBox>

            <Border Grid.Column="1" Margin="6,0,0,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                <views:DiffView DataContext="{Binding SelectedFileDiff}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
